#!/usr/bin/env bash
set -euo pipefail
LOG_FILE="${MOCK_LOG:-${BATS_TMPDIR:-/tmp}/mkdir.log}"
/bin/mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
echo "mkdir $*" >> "$LOG_FILE"
# Actually create directory if it's under temp dirs, otherwise just succeed (avoid creating real /tank)
for arg in "$@"; do
  if [[ "$arg" == -* ]]; then continue; fi
  if [[ "$arg" == /tmp/* ]] || [[ "$arg" == /var/* ]] || [[ "$arg" == "$MOCK_TMPDIR"* ]] || [[ "$arg" == /private/tmp/* ]] || [[ "$arg" == /private/var/* ]]; then
    /bin/mkdir -p "$arg" 2>/dev/null || true
  fi
done
exit 0
