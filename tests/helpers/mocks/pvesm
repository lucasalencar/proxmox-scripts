#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/../mock_lib.sh"
mock_log "pvesm" "$@"

if [[ "${1:-}" == "status" ]]; then
  if [ -n "${MOCK_PVESM_STATUS+set}" ]; then
    echo -e "$MOCK_PVESM_STATUS"
  else
    # Default: includes local-lvm
    cat <<'EOF'
Name             Type     Status           Total            Used       Available        %
local             dir     active        100000000        10000000        90000000     10.00%
local-lvm         lvmthin active        200000000        50000000       150000000     25.00%
EOF
  fi
  exit 0
fi
exit 0
