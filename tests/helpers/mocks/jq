#!/usr/bin/env bash
# Mock for jq — if MOCK_JQ_OUTPUT set, use it, else delegate to real jq
set -euo pipefail
source "$(dirname "$0")/../mock_lib.sh"
mock_log "jq" "$@"
if [ -n "${MOCK_JQ_OUTPUT:-}" ]; then
  echo -e "$MOCK_JQ_OUTPUT"
  exit 0
fi
# Try real jq
if command -v /opt/homebrew/bin/jq >/dev/null 2>&1; then
  /opt/homebrew/bin/jq "$@"
elif command -v /usr/bin/jq >/dev/null 2>&1; then
  /usr/bin/jq "$@"
else
  # fallback: just cat input
  cat
fi
