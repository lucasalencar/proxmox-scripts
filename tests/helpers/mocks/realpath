#!/usr/bin/env bash
set -euo pipefail
LOG_FILE="${MOCK_LOG:-${BATS_TMPDIR:-/tmp}/realpath.log}"
/bin/mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
echo "realpath $*" >> "$LOG_FILE"

# If MOCK_REALPATH is set, use it
if [ -n "${MOCK_REALPATH:-}" ]; then
  echo "$MOCK_REALPATH"
  exit 0
fi

# Handle -m etc: just return last arg as path
# For -m, realpath -m /path returns canonical path; we can delegate to real realpath if exists
if command -v /bin/realpath >/dev/null 2>&1; then
  /bin/realpath "$@" 2>/dev/null || echo "${!#}"
  exit 0
fi
# fallback: echo last arg
echo "${!#}"
