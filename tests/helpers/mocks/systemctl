#!/usr/bin/env bash
# Mock for systemctl — is-active/start/restart/enable controlled via env vars.
set -euo pipefail

source "$(dirname "$0")/../mock_lib.sh"
mock_log "systemctl" "$@"

state_file="${MOCK_TMPDIR:-/tmp}/systemctl-started"
counter_file="${MOCK_TMPDIR:-/tmp}/systemctl-isactive-count"

case "${1:-}" in
  is-active)
    # MOCK_SYSTEMCTL_ACTIVE=1 means inactive, unless a start has since succeeded
    if [ "${MOCK_SYSTEMCTL_ACTIVE:-0}" = "1" ] && [ ! -f "$state_file" ]; then
      exit 1
    fi
    # MOCK_SYSTEMCTL_FAIL_SECOND_CHECK=1 fails every is-active from the 2nd call on
    if [ "${MOCK_SYSTEMCTL_FAIL_SECOND_CHECK:-0}" = "1" ]; then
      count=0
      if [ -f "$counter_file" ]; then
        count=$(cat "$counter_file")
      fi
      count=$((count + 1))
      echo "$count" > "$counter_file"
      if [ "$count" -ge 2 ]; then
        exit 1
      fi
    fi
    exit 0
    ;;
  start|restart|enable)
    if [ "${MOCK_SYSTEMCTL_FAIL:-0}" = "1" ]; then
      exit 1
    fi
    if [ "${1:-}" = "start" ]; then
      : > "$state_file"
    fi
    exit 0
    ;;
  daemon-reload)
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
